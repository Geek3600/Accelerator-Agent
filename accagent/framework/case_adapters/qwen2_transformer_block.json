{
  "schema_version": "spatialaccagent.model_semantic_adapter.v1",
  "model_family": "qwen2",
  "accelerator_scope": "transformer_blocks_only",
  "decoder_layer_tensor_patterns": [
    "^model\\.layers\\.(?P<layer>\\d+)\\.(?P<suffix>.+)$"
  ],
  "excluded_model_regions": [
    "embedding",
    "final_model_norm",
    "lm_head",
    "tokenizer",
    "sampling"
  ],
  "pipeline_dataflow": {
    "schema_version": "spatialaccagent.pipeline_dataflow.v1",
    "boundary_numeric": {
      "input": "accumulator",
      "output": "accumulator"
    },
    "stage_metadata": {
      "rms_norm_1": {
        "shape": {"input": "hidden", "output": "hidden"},
        "numeric": {"input": "accumulator", "internal": "accumulator", "output": "activation"},
        "latency_kind": "pointwise_hidden"
      },
      "self_attention": {
        "shape": {"input": "hidden", "output": "hidden"},
        "numeric": {"input": "activation", "internal": "activation", "output": "accumulator"},
        "latency_kind": "self_attention"
      },
      "residual_add_1": {
        "shape": {"input": "hidden", "output": "hidden"},
        "numeric": {"input": "accumulator", "internal": "accumulator", "output": "accumulator"},
        "latency_kind": "pointwise_hidden"
      },
      "rms_norm_2": {
        "shape": {"input": "hidden", "output": "hidden"},
        "numeric": {"input": "accumulator", "internal": "accumulator", "output": "activation"},
        "latency_kind": "pointwise_hidden"
      },
      "mlp_gate_proj": {
        "shape": {"input": "hidden", "output": "intermediate"},
        "numeric": {"input": "activation", "internal": "activation", "output": "activation"},
        "latency_kind": "linear_hidden_to_intermediate"
      },
      "mlp_up_proj": {
        "shape": {"input": "hidden", "output": "intermediate"},
        "numeric": {"input": "activation", "internal": "activation", "output": "activation"},
        "latency_kind": "linear_hidden_to_intermediate"
      },
      "activation_mul": {
        "shape": {"input": "intermediate", "output": "intermediate"},
        "numeric": {"input": "activation", "internal": "activation", "output": "activation"},
        "latency_kind": "pointwise_intermediate"
      },
      "mlp_down_proj": {
        "shape": {"input": "intermediate", "output": "hidden"},
        "numeric": {"input": "activation", "internal": "activation", "output": "accumulator"},
        "latency_kind": "linear_intermediate_to_hidden"
      },
      "residual_add_2": {
        "shape": {"input": "hidden", "output": "hidden"},
        "numeric": {"input": "accumulator", "internal": "accumulator", "output": "accumulator"},
        "latency_kind": "pointwise_hidden"
      }
    },
    "edges": [
      {"source": "block_input", "destination": "rms_norm_1", "kind": "input"},
      {"source": "block_input", "destination": "residual_add_1", "kind": "residual_skip", "source_port": "residual", "destination_port": "skip"},
      {"source": "rms_norm_1", "destination": "self_attention"},
      {"source": "self_attention", "destination": "residual_add_1", "destination_port": "main"},
      {"source": "residual_add_1", "destination": "rms_norm_2"},
      {"source": "residual_add_1", "destination": "residual_add_2", "kind": "residual_skip", "source_port": "residual", "destination_port": "skip"},
      {"source": "rms_norm_2", "destination": "mlp_gate_proj", "kind": "mlp_gate_branch"},
      {"source": "rms_norm_2", "destination": "mlp_up_proj", "kind": "mlp_up_branch"},
      {"source": "mlp_gate_proj", "destination": "activation_mul", "kind": "mlp_gate_to_mul", "destination_port": "lhs"},
      {"source": "mlp_up_proj", "destination": "activation_mul", "kind": "mlp_up_to_mul", "destination_port": "rhs"},
      {"source": "activation_mul", "destination": "mlp_down_proj"},
      {"source": "mlp_down_proj", "destination": "residual_add_2", "destination_port": "main"},
      {"source": "residual_add_2", "destination": "block_output", "kind": "output"}
    ],
    "weight_storage_terms": [
      {"id": "input_norm_weight", "stage": "rms_norm_1", "physical_role": "weight", "dtype_role": "weight", "factors": ["hidden_size"]},
      {"id": "q_proj_weight", "stage": "self_attention", "physical_role": "weight_qkv", "dtype_role": "weight", "factors": ["hidden_size", "num_q_heads", "head_dim"]},
      {"id": "q_proj_bias", "stage": "self_attention", "physical_role": "weight_qkv_bias", "dtype_role": "weight", "factors": ["num_q_heads", "head_dim"]},
      {"id": "k_proj_weight", "stage": "self_attention", "physical_role": "weight_qkv", "dtype_role": "weight", "factors": ["hidden_size", "num_kv_heads", "head_dim"]},
      {"id": "k_proj_bias", "stage": "self_attention", "physical_role": "weight_qkv_bias", "dtype_role": "weight", "factors": ["num_kv_heads", "head_dim"]},
      {"id": "v_proj_weight", "stage": "self_attention", "physical_role": "weight_qkv", "dtype_role": "weight", "factors": ["hidden_size", "num_kv_heads", "head_dim"]},
      {"id": "v_proj_bias", "stage": "self_attention", "physical_role": "weight_qkv_bias", "dtype_role": "weight", "factors": ["num_kv_heads", "head_dim"]},
      {"id": "o_proj_weight", "stage": "self_attention", "physical_role": "weight_attn_out", "dtype_role": "weight", "factors": ["hidden_size", "hidden_size"]},
      {"id": "post_attention_norm_weight", "stage": "rms_norm_2", "physical_role": "weight", "dtype_role": "weight", "factors": ["hidden_size"]},
      {"id": "mlp_gate_weight", "stage": "mlp_gate_proj", "physical_role": "weight_mlp_gate", "dtype_role": "weight", "factors": ["hidden_size", "intermediate_size"]},
      {"id": "mlp_up_weight", "stage": "mlp_up_proj", "physical_role": "weight_mlp_up", "dtype_role": "weight", "factors": ["hidden_size", "intermediate_size"]},
      {"id": "mlp_down_weight", "stage": "mlp_down_proj", "physical_role": "weight_mlp_down", "dtype_role": "weight", "factors": ["intermediate_size", "hidden_size"]}
    ]
  },
  "implementation_contract": {
    "top_class": "Qwen2Block",
    "requires_position_input": true,
    "loader_ports": [
      "rms1Weight",
      "qkvWeight",
      "qkvBias",
      "ropeRuntime",
      "attentionOutWeight",
      "rms2Weight",
      "mlpGateWeight",
      "mlpUpWeight",
      "mlpDownWeight"
    ],
    "disabled_weight_ports": [],
    "params": {
      "class": "LlamaStyleBlockParams",
      "bindings": {
        "hiddenSize": "hidden_size",
        "qHeads": "num_q_heads",
        "kvHeads": "num_kv_heads",
        "headDim": "head_dim",
    "intermediateSize": "intermediate_size",
    "lanes": "lanes",
    "computeArrayRows": "compute_array_rows",
    "computeArrayCols": "compute_array_cols",
    "batchSize": "token_count",
        "maxSeqLen": "max_seq_len",
        "inputBits": "input_bits",
        "elemBits": "elem_bits",
        "outputBits": "output_bits"
      }
    }
  },
  "semantic_runtime_streams": {
    "self_attention": {
      "source_order": [
        "position_ids",
        "cache_position",
        "rope_cos",
        "rope_sin"
      ],
      "targets": {
        "position_ids": {
          "target_id": "attention.position_ids",
          "semantic_role": "position_ids",
          "storage_dtype": "uint32",
          "source_axis_order": ["batch", "token"],
          "drop_singleton_axes": [0],
          "address_formula": "token",
          "sharing": "one position id per input token"
        },
        "cache_position": {
          "target_id": "attention.cache_position",
          "semantic_role": "cache_position",
          "storage_dtype": "uint32",
          "source_axis_order": ["token"],
          "drop_singleton_axes": [],
          "address_formula": "token",
          "sharing": "one cache position per input token; use_cache remains false for this verification run"
        },
        "rope_cos": {
          "target_id": "attention.rope.cos_table",
          "semantic_role": "rotary_cosine",
          "storage_dtype": "fp16",
          "source_axis_order": ["batch", "token", "head_dimension"],
          "drop_singleton_axes": [0],
          "address_formula": "token * head_dimension_count + head_dimension",
          "sharing": "shared across all query and key heads"
        },
        "rope_sin": {
          "target_id": "attention.rope.sin_table",
          "semantic_role": "rotary_sine",
          "storage_dtype": "fp16",
          "source_axis_order": ["batch", "token", "head_dimension"],
          "drop_singleton_axes": [0],
          "address_formula": "token * head_dimension_count + head_dimension",
          "sharing": "shared across all query and key heads"
        }
      }
    }
  },
  "semantic_stages": {
    "rms_norm_1": {
      "inputs": [
        {"source": "accelerator_input"}
      ],
      "expected": {"record": "input_layernorm", "value": "output"},
      "required_weight_suffixes": ["input_layernorm.weight"]
    },
    "self_attention": {
      "inputs": [
        {"record": "input_layernorm", "value": "output"}
      ],
      "expected": {"record": "self_attn", "value": "output"},
      "required_weight_suffixes": [
        "self_attn.q_proj.weight",
        "self_attn.q_proj.bias",
        "self_attn.k_proj.weight",
        "self_attn.k_proj.bias",
        "self_attn.v_proj.weight",
        "self_attn.v_proj.bias",
        "self_attn.o_proj.weight"
      ]
    },
    "residual_add_1": {
      "inputs": [
        {"source": "accelerator_input"},
        {"record": "self_attn", "value": "output"}
      ],
      "expected": {"record": "post_attention_layernorm", "value": "input"},
      "required_weight_suffixes": []
    },
    "rms_norm_2": {
      "inputs": [
        {"record": "post_attention_layernorm", "value": "input"}
      ],
      "expected": {"record": "post_attention_layernorm", "value": "output"},
      "required_weight_suffixes": ["post_attention_layernorm.weight"]
    },
    "mlp_gate_proj": {
      "inputs": [
        {"record": "post_attention_layernorm", "value": "output"}
      ],
      "expected": {"record": "mlp.gate_proj", "value": "output"},
      "required_weight_suffixes": ["mlp.gate_proj.weight"]
    },
    "mlp_up_proj": {
      "inputs": [
        {"record": "post_attention_layernorm", "value": "output"}
      ],
      "expected": {"record": "mlp.up_proj", "value": "output"},
      "required_weight_suffixes": ["mlp.up_proj.weight"]
    },
    "activation_mul": {
      "inputs": [
        {"record": "mlp.gate_proj", "value": "output"},
        {"record": "mlp.up_proj", "value": "output"}
      ],
      "expected": {"record": "mlp.down_proj", "value": "input"},
      "required_weight_suffixes": []
    },
    "mlp_down_proj": {
      "inputs": [
        {"record": "mlp.down_proj", "value": "input"}
      ],
      "expected": {"record": "mlp.down_proj", "value": "output"},
      "required_weight_suffixes": ["mlp.down_proj.weight"]
    },
    "residual_add_2": {
      "inputs": [
        {"record": "post_attention_layernorm", "value": "input"},
        {"record": "mlp", "value": "output"}
      ],
      "expected": {"record": "decoder_layer_0", "value": "output"},
      "required_weight_suffixes": []
    }
  }
}
