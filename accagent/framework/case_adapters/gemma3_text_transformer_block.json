{
  "schema_version": "spatialaccagent.model_semantic_adapter.v1",
  "model_family": "gemma3_text",
  "accelerator_scope": "transformer_blocks_only",
  "decoder_layer_tensor_patterns": [
    "^model\\.language_model\\.layers\\.(?P<layer>\\d+)\\.(?P<suffix>.+)$",
    "^model\\.layers\\.(?P<layer>\\d+)\\.(?P<suffix>.+)$"
  ],
  "excluded_model_regions": [
    "embed_tokens",
    "embedding",
    "norm",
    "lm_head",
    "tokenizer",
    "sampling"
  ],
  "pipeline_dataflow": {
    "schema_version": "spatialaccagent.pipeline_dataflow.v1",
    "boundary_numeric": {"input": "accumulator", "output": "accumulator"},
    "stage_metadata": {
      "rms_norm_input": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "accumulator", "internal": "accumulator", "output": "activation"}, "latency_kind": "pointwise_hidden"},
      "self_attention": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "activation", "internal": "activation", "output": "accumulator"}, "latency_kind": "self_attention", "latency_features": ["multi_query", "sliding_window"]},
      "rms_norm_post_attention": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "accumulator", "internal": "accumulator", "output": "activation"}, "latency_kind": "pointwise_hidden"},
      "residual_add_1": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "accumulator", "internal": "accumulator", "output": "accumulator"}, "latency_kind": "pointwise_hidden"},
      "rms_norm_pre_ffn": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "accumulator", "internal": "accumulator", "output": "activation"}, "latency_kind": "pointwise_hidden"},
      "mlp_gate_proj": {"shape": {"input": "hidden", "output": "intermediate"}, "numeric": {"input": "activation", "internal": "activation", "output": "activation"}, "latency_kind": "linear_hidden_to_intermediate"},
      "mlp_up_proj": {"shape": {"input": "hidden", "output": "intermediate"}, "numeric": {"input": "activation", "internal": "activation", "output": "activation"}, "latency_kind": "linear_hidden_to_intermediate"},
      "activation_mul": {"shape": {"input": "intermediate", "output": "intermediate"}, "numeric": {"input": "activation", "internal": "activation", "output": "activation"}, "latency_kind": "pointwise_intermediate", "latency_features": ["gelu_tanh", "gated_multiply"]},
      "mlp_down_proj": {"shape": {"input": "intermediate", "output": "hidden"}, "numeric": {"input": "activation", "internal": "activation", "output": "accumulator"}, "latency_kind": "linear_intermediate_to_hidden"},
      "rms_norm_post_ffn": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "accumulator", "internal": "accumulator", "output": "activation"}, "latency_kind": "pointwise_hidden"},
      "residual_add_2": {"shape": {"input": "hidden", "output": "hidden"}, "numeric": {"input": "accumulator", "internal": "accumulator", "output": "accumulator"}, "latency_kind": "pointwise_hidden"}
    },
    "edges": [
      {"source": "block_input", "destination": "rms_norm_input", "kind": "input"},
      {"source": "block_input", "destination": "residual_add_1", "kind": "residual_skip", "source_port": "residual", "destination_port": "skip"},
      {"source": "rms_norm_input", "destination": "self_attention"},
      {"source": "self_attention", "destination": "rms_norm_post_attention"},
      {"source": "rms_norm_post_attention", "destination": "residual_add_1", "destination_port": "main"},
      {"source": "residual_add_1", "destination": "rms_norm_pre_ffn"},
      {"source": "residual_add_1", "destination": "residual_add_2", "kind": "residual_skip", "source_port": "residual", "destination_port": "skip"},
      {"source": "rms_norm_pre_ffn", "destination": "mlp_gate_proj", "kind": "mlp_gate_branch"},
      {"source": "rms_norm_pre_ffn", "destination": "mlp_up_proj", "kind": "mlp_up_branch"},
      {"source": "mlp_gate_proj", "destination": "activation_mul", "kind": "mlp_gate_to_mul", "destination_port": "lhs"},
      {"source": "mlp_up_proj", "destination": "activation_mul", "kind": "mlp_up_to_mul", "destination_port": "rhs"},
      {"source": "activation_mul", "destination": "mlp_down_proj"},
      {"source": "mlp_down_proj", "destination": "rms_norm_post_ffn"},
      {"source": "rms_norm_post_ffn", "destination": "residual_add_2", "destination_port": "main"},
      {"source": "residual_add_2", "destination": "block_output", "kind": "output"}
    ],
    "weight_storage_terms": [
      {"id": "input_norm_weight", "stage": "rms_norm_input", "physical_role": "weight", "dtype_role": "weight", "factors": ["hidden_size"]},
      {"id": "q_proj_weight", "stage": "self_attention", "physical_role": "weight_qkv", "dtype_role": "weight", "factors": ["hidden_size", "num_q_heads", "head_dim"]},
      {"id": "k_proj_weight", "stage": "self_attention", "physical_role": "weight_qkv", "dtype_role": "weight", "factors": ["hidden_size", "num_kv_heads", "head_dim"]},
      {"id": "v_proj_weight", "stage": "self_attention", "physical_role": "weight_qkv", "dtype_role": "weight", "factors": ["hidden_size", "num_kv_heads", "head_dim"]},
      {"id": "q_norm_weight", "stage": "self_attention", "physical_role": "weight_q_norm", "dtype_role": "weight", "factors": ["head_dim"]},
      {"id": "k_norm_weight", "stage": "self_attention", "physical_role": "weight_k_norm", "dtype_role": "weight", "factors": ["head_dim"]},
      {"id": "o_proj_weight", "stage": "self_attention", "physical_role": "weight_attn_out", "dtype_role": "weight", "factors": ["num_q_heads", "head_dim", "hidden_size"]},
      {"id": "post_attention_norm_weight", "stage": "rms_norm_post_attention", "physical_role": "weight", "dtype_role": "weight", "factors": ["hidden_size"]},
      {"id": "pre_ffn_norm_weight", "stage": "rms_norm_pre_ffn", "physical_role": "weight", "dtype_role": "weight", "factors": ["hidden_size"]},
      {"id": "mlp_gate_weight", "stage": "mlp_gate_proj", "physical_role": "weight_mlp_gate", "dtype_role": "weight", "factors": ["hidden_size", "intermediate_size"]},
      {"id": "mlp_up_weight", "stage": "mlp_up_proj", "physical_role": "weight_mlp_up", "dtype_role": "weight", "factors": ["hidden_size", "intermediate_size"]},
      {"id": "mlp_down_weight", "stage": "mlp_down_proj", "physical_role": "weight_mlp_down", "dtype_role": "weight", "factors": ["intermediate_size", "hidden_size"]},
      {"id": "post_ffn_norm_weight", "stage": "rms_norm_post_ffn", "physical_role": "weight", "dtype_role": "weight", "factors": ["hidden_size"]}
    ]
  },
  "implementation_contract": {
    "top_class": "Gemma3TextBlock",
    "requires_position_input": true,
    "loader_ports": [
      "rmsInWeight", "qkvWeight", "qNormWeight", "kNormWeight", "ropeRuntime",
      "attentionOutWeight", "postAttentionNormWeight", "preFfnNormWeight",
      "mlpGateWeight", "mlpUpWeight", "mlpDownWeight", "postFfnNormWeight"
    ],
    "disabled_weight_ports": ["qkvBias"],
    "params": {
      "class": "Gemma3TextBlockParams",
      "bindings": {
        "hiddenSize": "hidden_size",
        "qHeads": "num_q_heads",
        "kvHeads": "num_kv_heads",
        "headDim": "head_dim",
        "intermediateSize": "intermediate_size",
        "lanes": "lanes",
        "computeArrayRows": "compute_array_rows",
        "computeArrayCols": "compute_array_cols",
        "batchSize": "token_count",
        "maxSeqLen": "max_seq_len",
        "inputBits": "input_bits",
        "elemBits": "elem_bits",
        "outputBits": "output_bits",
        "weightBits": "weight_bits",
        "accBits": "acc_bits",
        "integerMode": "integer_mode"
      }
    }
  },
  "semantic_runtime_streams": {
    "self_attention": {
      "source_order": ["position_ids", "cache_position", "rope_cos", "rope_sin"],
      "targets": {
        "position_ids": {"target_id": "attention.position_ids", "semantic_role": "position_ids", "storage_dtype": "uint32", "source_axis_order": ["batch", "token"], "drop_singleton_axes": [0], "address_formula": "token", "sharing": "one position id per input token"},
        "cache_position": {"target_id": "attention.cache_position", "semantic_role": "cache_position", "storage_dtype": "uint32", "source_axis_order": ["token"], "drop_singleton_axes": [], "address_formula": "token", "sharing": "one cache position per input token"},
        "rope_cos": {"target_id": "attention.rope.cos_table", "semantic_role": "rotary_cosine", "storage_dtype": "fp16", "source_axis_order": ["batch", "token", "head_dimension"], "drop_singleton_axes": [0], "address_formula": "token * head_dimension_count + head_dimension", "sharing": "global/local RoPE table selected by the model schedule"},
        "rope_sin": {"target_id": "attention.rope.sin_table", "semantic_role": "rotary_sine", "storage_dtype": "fp16", "source_axis_order": ["batch", "token", "head_dimension"], "drop_singleton_axes": [0], "address_formula": "token * head_dimension_count + head_dimension", "sharing": "global/local RoPE table selected by the model schedule"}
      }
    }
  },
  "semantic_stages": {
    "rms_norm_input": {"inputs": [{"source": "accelerator_input"}], "expected": {"record": "input_layernorm", "value": "output"}, "required_weight_suffixes": ["input_layernorm.weight"]},
    "self_attention": {"inputs": [{"record": "input_layernorm", "value": "output"}], "expected": {"record": "self_attn", "value": "output"}, "required_weight_suffixes": ["self_attn.q_proj.weight", "self_attn.k_proj.weight", "self_attn.v_proj.weight", "self_attn.o_proj.weight", "self_attn.q_norm.weight", "self_attn.k_norm.weight"]},
    "rms_norm_post_attention": {"inputs": [{"record": "self_attn", "value": "output"}], "expected": {"record": "post_attention_layernorm", "value": "output"}, "required_weight_suffixes": ["post_attention_layernorm.weight"]},
    "residual_add_1": {"inputs": [{"source": "accelerator_input"}, {"record": "post_attention_layernorm", "value": "output"}], "expected": {"record": "pre_feedforward_layernorm", "value": "input"}, "required_weight_suffixes": []},
    "rms_norm_pre_ffn": {"inputs": [{"record": "pre_feedforward_layernorm", "value": "input"}], "expected": {"record": "pre_feedforward_layernorm", "value": "output"}, "required_weight_suffixes": ["pre_feedforward_layernorm.weight"]},
    "mlp_gate_proj": {"inputs": [{"record": "pre_feedforward_layernorm", "value": "output"}], "expected": {"record": "mlp.gate_proj", "value": "output"}, "required_weight_suffixes": ["mlp.gate_proj.weight"]},
    "mlp_up_proj": {"inputs": [{"record": "pre_feedforward_layernorm", "value": "output"}], "expected": {"record": "mlp.up_proj", "value": "output"}, "required_weight_suffixes": ["mlp.up_proj.weight"]},
    "activation_mul": {"inputs": [{"record": "mlp.gate_proj", "value": "output"}, {"record": "mlp.up_proj", "value": "output"}], "expected": {"record": "mlp.down_proj", "value": "input"}, "required_weight_suffixes": []},
    "mlp_down_proj": {"inputs": [{"record": "mlp.down_proj", "value": "input"}], "expected": {"record": "post_feedforward_layernorm", "value": "input"}, "required_weight_suffixes": ["mlp.down_proj.weight"]},
    "rms_norm_post_ffn": {"inputs": [{"record": "post_feedforward_layernorm", "value": "input"}], "expected": {"record": "post_feedforward_layernorm", "value": "output"}, "required_weight_suffixes": ["post_feedforward_layernorm.weight"]},
    "residual_add_2": {"inputs": [{"record": "pre_feedforward_layernorm", "value": "input"}, {"record": "post_feedforward_layernorm", "value": "output"}], "expected": {"record": "decoder_layer_0", "value": "output"}, "required_weight_suffixes": []}
  }
}
