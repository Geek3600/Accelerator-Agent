      "atol": "framework_default",
      "max_mismatch_fraction": "framework_default",
      "rtol": "framework_default"
    },
    "provided_values_take_precedence": true,
    "resolved": {
      "atol": 0.1,
      "max_mismatch_fraction": 0.05,
      "rtol": 0.1
    },
    "schema_version": "spatialaccagent.numeric_comparison_resolution.v1"
  },
  "default_rules": {
    "acc_dtype": "fp32",
    "activation_dtype": "fp16",
    "rounding": "nearest_even",
    "saturation": false,
    "scale_dtype": "fp16",
    "weight_dtype": "fp16"
  },
  "notes": [
    "Explicit numeric policy provided in current_run_numeric_policy.md; README fallback policy is not used for this run.",
