{
  "model_type": "llama",
  "num_layers": 22,
  "hidden_size": 2048,
  "target_max_seq_len": 16,
  "block": {
    "type": "decoder",
    "operator_sequence": [
      "rms_norm_1",
      "self_attention",
      "residual_add_1",
      "rms_norm_2",
      "mlp_gate_proj",
      "mlp_up_proj",
      "activation_mul",
      "mlp_down_proj",
      "residual_add_2"
    ]
  },
  "attention": {
    "kind": "gqa",
    "num_q_heads": 32,
    "num_kv_heads": 4,
    "head_dim": 64,
    "causal": true,
    "position_encoding": {
      "type": "rope",
      "rope_theta": 10000.0
    },
    "qkv_bias": false,
    "out_bias": false
  },
  "norm": {
    "type": "rms_norm",
    "position": "pre",
    "eps": 1e-05,
    "has_bias": false
  },
  "mlp": {
    "type": "gated",
    "intermediate_size": 5632,
    "activation": "silu",
    "up_bias": false,
    "down_bias": false
  },
  "weight_layout": {
    "qkv": "separate_q_k_v",
    "out_proj": "dense",
    "mlp": "gate_up_down",
    "norm": "weight_only"
  }
}
